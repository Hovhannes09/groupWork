<!DOCTYPE html>
<html>
  <head>
    <title>Cinema</title>
    <link rel="stylesheet" href="/stylesheet/style.css" />
  </head>
  <body>
    <h1>Movies</h1>

    <div id="films"></div>

    <script>
      async function loadFilms() {
        const response = await fetch("/films");
        const data = await response.json();

        const container = document.getElementById("films");

        for (const film of data.films) {
          const filmRes = await fetch(`/films/${film.id}`);
          const filmData = await filmRes.json();

          const showtimes = filmData.showtime || [];

          const showtimesHTML = showtimes.length
            ? showtimes
                .map(
                  (st) => `
							<div>
								<p> Date: ${st.showDate}</p>
								<p> Time: ${st.showTime}</p>
								<p> Price: $${st.price}</p>
								<p> Seats: ${st.totalSeats}</p>
							</div>
						`,
                )
                .join("<hr>")
            : "<p>No showtimes available</p>";

          container.innerHTML += `
						<div>
							<h2>${film.title}</h2>
							<p>${film.description}</p>
							<p>Genre: ${film.genre}</p>
							<p>Duration: ${film.duration} min</p>
							<h3>Showtimes:</h3>
							${showtimesHTML}
						</div>
						<hr>
					`;
        }
      }

      loadFilms();
    </script>
  </body>
</html>
